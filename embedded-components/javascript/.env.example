# Copy to .env and fill in. Read by the Vite dev server only — never inlined into the
# client bundle, which is why none of these carry a VITE_ prefix.

# OAuth2 client-credentials used server-side to mint a session (POST /api/v2/Token/serverside).
PAYABLI_CLIENT_ID=
PAYABLI_CLIENT_SECRET=

# Paypoint entry point, passed as `entryPoint` in the Session/init request body.
PAYABLI_ENTRYPOINT=

# Optional. Defaults shown.
# Org slug in the API path (/api/v2/{slug}/Session/init). Becomes session.entryName,
# which the SDK uses to build its own refresh calls.
PAYABLI_ENTRYNAME=payabli
# API host. QA for now, since ECv2 hasn't launched: https://api-qa.payabli.com
# Once live: https://api-sandbox.payabli.com or https://api.payabli.com
PAYABLI_API_ORIGIN=https://api-qa.payabli.com
# What the SDK reports as session.environment (production | sandbox | qa | local).
PAYABLI_ENVIRONMENT=qa
# Fallback only — the server reads the real parent origin from each request's
# Origin/Referer header, so this rarely needs to be set. Useful for a client that
# sends neither (unusual). Leave unset to test through both localhost and a tunnel
# (ngrok, etc.) at the same time without editing this file.
# PAYABLI_PARENT_ORIGIN=http://localhost:5173
