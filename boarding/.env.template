# your Payabli OAuth2 client credentials (server-side only, never exposed to the browser)
PAYABLI_CLIENT_ID="YOUR_CLIENT_ID"
PAYABLI_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# what Payabli environment to use: "sandbox" for testing, "production" for live
PAYABLI_ENVIRONMENT="sandbox"

# optional: a v2 boarding template reference (UUID) to apply to created applications.
# leave unset to create applications without a template.
PAYABLI_BOARDING_TEMPLATE_REFERENCE=

# your better-auth secret
BETTER_AUTH_SECRET=ABC...123

# base URL of your app
BETTER_AUTH_URL=http://localhost:4321 # https://my-production-site.com
